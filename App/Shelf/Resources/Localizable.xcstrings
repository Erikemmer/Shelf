    "%@ reads RAR but not RAR5. A CBR in RAR5 falls back to its file name.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liest RAR, aber kein RAR5. Bei einem CBR in RAR5 bleibt der Dateiname."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reads RAR but not RAR5. A CBR in RAR5 falls back to its file name."
          }
        }
      }
    },
    "%@ says this; the other service says something else. Ticked neither, because that is a decision. Ticking one unticks the other": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sagt dies; der andere Dienst sagt etwas anderes. Keines ist angehakt, denn das ist eine Entscheidung. Haken Sie eines an, verschwindet der Haken beim anderen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ says this; the other service says something else. Ticked neither, because that is a decision. Ticking one unticks the other"
          }
        }
      }
    },
    "%@ would be replaced. Not ticked for you: that is your library's answer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ würde ersetzt. Nicht für Sie angehakt: das ist die Antwort Ihrer Bibliothek"
