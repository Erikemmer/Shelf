    "That is not an image Shelf recognises, so nothing was written.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Bild, das Shelf erkennt – es wurde nichts geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not an image Shelf recognises, so nothing was written."
          }
        }
      }
    },
    "The book files alone. The rating, the read status, the tags and the shelves will not go with them — they live in the metadata.opf, and that is not written.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Buchdateien. Bewertung, Gelesen-Status, Tags und Regale gehen nicht mit – sie stehen in der metadata.opf, und die wird nicht geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The book files alone. The rating, the read status, the tags and the shelves will not go with them — they live in the metadata.opf, and that is not written."
          }
        }
      }
    },
    "The books stay in the library. Only the shelf goes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bücher bleiben in der Bibliothek. Nur das Regal geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The books stay in the library. Only the shelf goes."
          }
        }
      }
    },
    "The cover could not be fetched: %@": {
      "extractionState": "manual",
