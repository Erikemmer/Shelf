    "On the same disk a link costs no space at all. Safe because Shelf never writes a book file. Across disks it is a copy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf derselben Platte kostet ein Link überhaupt keinen Platz. Unbedenklich, weil Shelf nie eine Buchdatei schreibt. Über Plattengrenzen hinweg wird kopiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the same disk a link costs no space at all. Safe because Shelf never writes a book file. Across disks it is a copy."
          }
        }
      }
    },
