          }
        }
      }
    },
    "The files you chose are only read. Nothing there is changed, moved or deleted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählten Dateien werden nur gelesen. Dort wird nichts geändert, bewegt oder gelöscht."
